# ==========================================
# VAULTPAY ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to '.env' in both the root and 'backend' directories
# and fill in the actual values before running the application.

# ------------------------------------------
# FRONTEND (.env in the root directory)
# ------------------------------------------
VITE_API_URL=http://localhost:3000/api
VITE_APP_NAME=VaultPay
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------
# BACKEND (backend/.env)
# ------------------------------------------
PORT=3000
NODE_ENV=development
JWT_SECRET=your_super_secret_jwt_key_here
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vaultpay?retryWrites=true&w=majority"
